<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.DashboardLayoutMapper">

    <resultMap type="com.ruoyi.business.domain.DashboardLayout" id="DashboardLayoutResult">
        <result property="layoutId"    column="layout_id"    />
        <result property="userId"      column="user_id"      />
        <result property="tenantId"    column="tenant_id"    />
        <result property="layoutJson"  column="layout_json"  />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <select id="selectByUserId" parameterType="Long" resultMap="DashboardLayoutResult">
        select layout_id, user_id, tenant_id, layout_json, create_time, update_time
        from biz_user_dashboard_layout
        where user_id = #{userId}
    </select>

    <insert id="upsert" parameterType="com.ruoyi.business.domain.DashboardLayout">
        insert into biz_user_dashboard_layout (user_id, tenant_id, layout_json, create_time, update_time)
        values (#{userId}, #{tenantId}, #{layoutJson}, sysdate(), sysdate())
        on duplicate key update
            layout_json = values(layout_json),
            update_time = sysdate()
    </insert>

</mapper>
