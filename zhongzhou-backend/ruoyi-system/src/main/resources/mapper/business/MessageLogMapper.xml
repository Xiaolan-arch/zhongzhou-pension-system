<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.MessageLogMapper">

	<resultMap type="MessageLog" id="MessageLogResult">
		<id     property="logId"      column="log_id"      />
		<result property="tenantId"   column="tenant_id"   />
		<result property="familyId"   column="family_id"   />
		<result property="elderId"    column="elder_id"    />
		<result property="elderName"  column="elder_name"  />
		<result property="phone"      column="phone"       />
		<result property="openid"     column="openid"      />
		<result property="msgType"    column="msg_type"    />
		<result property="title"      column="title"       />
		<result property="content"    column="content"     />
		<result property="sendStatus" column="send_status" />
		<result property="errorMsg"   column="error_msg"   />
		<result property="createTime" column="create_time" />
	</resultMap>

	<select id="selectMessageLogList" parameterType="MessageLog" resultMap="MessageLogResult">
		select log_id, tenant_id, family_id, elder_id, elder_name, phone, openid,
			   msg_type, title, content, send_status, error_msg, create_time
		from biz_message_log
		<where>
			<if test="elderName != null and elderName != ''">
				and elder_name like concat('%', #{elderName}, '%')
			</if>
			<if test="msgType != null and msgType != ''">
				and msg_type = #{msgType}
			</if>
			<if test="sendStatus != null and sendStatus != ''">
				and send_status = #{sendStatus}
			</if>
		</where>
		order by log_id desc
	</select>

	<insert id="insertMessageLog" parameterType="MessageLog" useGeneratedKeys="true" keyProperty="logId">
		insert into biz_message_log(
			tenant_id, family_id, elder_id, elder_name, phone, openid,
			msg_type, title, content, send_status, error_msg, create_time
		)values(
			#{tenantId}, #{familyId}, #{elderId}, #{elderName}, #{phone}, #{openid},
			#{msgType}, #{title}, #{content}, #{sendStatus}, #{errorMsg}, sysdate()
		)
	</insert>

</mapper>
