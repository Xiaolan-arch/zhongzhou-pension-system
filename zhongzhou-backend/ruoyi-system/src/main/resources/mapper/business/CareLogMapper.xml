<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.CareLogMapper">

	<resultMap type="CareLog" id="CareLogResult">
		<id     property="logId"      column="log_id"      />
		<result property="elderId"    column="elder_id"    />
		<result property="elderName"  column="elder_name"  />
		<result property="tenantId"   column="tenant_id"   />
		<result property="logDate"    column="log_date"    />
		<result property="careType"   column="care_type"   />
		<result property="content"    column="content"     />
		<result property="nurseName"  column="nurse_name"  />
		<result property="delFlag"    column="del_flag"    />
		<result property="createBy"   column="create_by"   />
		<result property="createTime" column="create_time" />
		<result property="updateBy"   column="update_by"   />
		<result property="updateTime" column="update_time" />
	</resultMap>

	<sql id="selectCareLogVo">
		select log_id, elder_id, elder_name, tenant_id, log_date, care_type, content, nurse_name,
		       del_flag, create_by, create_time, update_by, update_time
		from biz_care_log
	</sql>

	<select id="selectCareLogList" parameterType="CareLog" resultMap="CareLogResult">
		<include refid="selectCareLogVo"/>
		<where>
			del_flag = '0'
			<if test="tenantId != null">
				AND tenant_id = #{tenantId}
			</if>
			<if test="elderId != null">
				AND elder_id = #{elderId}
			</if>
			<if test="elderName != null and elderName != ''">
				AND elder_name like concat('%', #{elderName}, '%')
			</if>
			<if test="careType != null and careType != ''">
				AND care_type = #{careType}
			</if>
			<if test="params.beginDate != null and params.beginDate != ''">
				AND log_date &gt;= #{params.beginDate}
			</if>
			<if test="params.endDate != null and params.endDate != ''">
				AND log_date &lt;= #{params.endDate}
			</if>
		</where>
		order by log_date desc, log_id desc
	</select>

	<select id="selectCareLogById" parameterType="Long" resultMap="CareLogResult">
		<include refid="selectCareLogVo"/>
		where log_id = #{logId} and del_flag = '0'
	</select>

	<insert id="insertCareLog" parameterType="CareLog" useGeneratedKeys="true" keyProperty="logId">
		insert into biz_care_log(
			elder_id,
			<if test="elderName != null">elder_name,</if>
			tenant_id,
			log_date,
			<if test="careType != null">care_type,</if>
			<if test="content != null">content,</if>
			<if test="nurseName != null">nurse_name,</if>
			del_flag,
			<if test="createBy != null">create_by,</if>
			create_time
		)values(
			#{elderId},
			<if test="elderName != null">#{elderName},</if>
			#{tenantId},
			#{logDate},
			<if test="careType != null">#{careType},</if>
			<if test="content != null">#{content},</if>
			<if test="nurseName != null">#{nurseName},</if>
			'0',
			<if test="createBy != null">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateCareLog" parameterType="CareLog">
		update biz_care_log
		<set>
			<if test="elderId != null">elder_id = #{elderId},</if>
			<if test="elderName != null">elder_name = #{elderName},</if>
			<if test="logDate != null">log_date = #{logDate},</if>
			<if test="careType != null">care_type = #{careType},</if>
			<if test="content != null">content = #{content},</if>
			<if test="nurseName != null">nurse_name = #{nurseName},</if>
			<if test="updateBy != null">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where log_id = #{logId}
	</update>

	<update id="deleteCareLogByIds" parameterType="Long">
		update biz_care_log set del_flag = '2' where log_id in
		<foreach collection="array" item="logId" open="(" separator="," close=")">
			#{logId}
		</foreach>
	</update>

</mapper>
